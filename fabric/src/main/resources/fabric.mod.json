{
  "schemaVersion": 1,
  "id": "${MODID}",
  "name": "${NAME}",
  "version": "${version}",
  "environment": "*",
  "icon": "assets/pingintablist/icon.png",
  "authors": ["${AUTHOR}"],
  "license": "Unlicense",
  "contact": {
    "homepage": "${CURSE_HOMEPAGE}",
    "sources": "${GIT_REPO}",
    "issues": "${GIT_REPO}/issues"
  },
  "description": "${DESCRIPTION}",
  "entrypoints": {
    "main": [
      "at.alex.pingintablist.PingInTablist"
    ],
    "modmenu": [
      "at.alex.pingintablist.impl.modmenu.ModMenuImpl"
    ]
  },
  "mixins": ["pingintablist.mixins.json"],
  "depends": {
    "fabricloader": ">=${FABRIC_LOADER}",
    "java": ">=${JAVA}",
    "minecraft": "${MINECRAFT}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
  